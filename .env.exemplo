# Copie este arquivo para .env na raiz do repositório e preencha os valores.
# O .env não é versionado: as chaves abaixo não podem ir para o git.

# Projeto Supabase do histórico (Project Settings, API)
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chave do grupo para o código mascarado dos componentes (src/frontend/dados/mascara.py).
# Todos do grupo precisam usar a mesma, ou os códigos não coincidem entre máquinas.
IGNIS_CHAVE_MASCARA=
